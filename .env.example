# Cortex Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://cortex:cortex@localhost:5433/cortex

# LLM Provider
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-v4-flash
LLM_JUDGE_MODEL=deepseek-v4-pro

# Embeddings (ADR-0008 semantic fact retrieval)
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIMENSIONS=1536

# Trace capture (rizzo-pii sidecar)
TRACE_SIDECAR_URL=http://127.0.0.1:5005
TRACE_SIDECAR_TIMEOUT_S=10.0

# Trace retention (cortex traces:cleanup deletes loop_events older than this)
TRACE_RETENTION_DAYS=30

# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# Learning / ESN reservoir (ADR-0001)
LEARNING_RESERVOIR_SIZE=500
LEARNING_SPECTRAL_RADIUS=0.9
LEARNING_INPUT_SCALE=1.0
LEARNING_LEAK_RATE=0.3
LEARNING_RIDGE_LAMBDA=0.000001

# Safety net — backups/snapshots/journal (ADR-0021)
SAFETY_STORE_DIR=~/.local/share/cortex
SAFETY_BACKUP_RETENTION=14
SAFETY_BACKUP_ON_MIGRATION=true
SAFETY_REQUIRE_BACKUP_BEFORE_MIGRATION=true

# Host uid/gid used by the compose cortex service so the mounted safety store
# stays owned by the host user (defaults to 1000:1000).
# UID=1000
# GID=1000
